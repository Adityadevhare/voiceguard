# Copy this file to `.env` and replace the placeholders with your real values.
# Never commit the real `.env` file.

# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Port the backend listens on.
PORT=5000

# Allowed frontend origin for CORS.
CORS_ORIGIN="http://localhost:5173"

# Base URL of the Python ML inference service (used for voice analysis).
# The actual service does not exist yet. When it is ready, set this to e.g.
# http://localhost:8000. If it is left unset, POST /api/detection returns a
# controlled 503 "ML service unavailable" response instead of crashing.
ML_SERVICE_URL=""

# Timeout (ms) for requests sent to the Python ML service.
ML_SERVICE_TIMEOUT_MS=10000

# Maximum size of the JSON request body (audio is base64-encoded).
# A 6mb body comfortably fits the default 4mb decoded-audio cap.
REQUEST_BODY_LIMIT="6mb"